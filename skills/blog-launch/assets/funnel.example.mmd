flowchart TD
  REELS["Instagram: кодовое слово"] --> MC["ManyChat: приватный ответ"]
  MC --> ACT{"Ответ или Quick Reply?"}
  ACT -->|Нет| STOP_IG["Остановка IG"]
  ACT -->|Да| FOLLOW{"Необязательная проверка подписки"}
  FOLLOW -->|Подтверждено| TG_LINK["Ссылка на Telegram"]
  FOLLOW -->|Пропустить| TG_LINK
  FOLLOW -->|Ошибка проверки| TG_LINK
  TRUST["YouTube TRUST"] --> HUB["YouTube HUB"]
  HUB --> TG_LINK
  PROFILE["Профиль или другой разрешённый вход"] --> TG_LINK
  TG_LINK --> START{"Пользователь нажал Start?"}
  START -->|Нет| STOP_TG["Ожидание запуска без автоотправки"]
  START -->|Да| LM["Выдать обещанный материал"]
  LM --> CONSENT{"Согласие на серию и предложения?"}
  CONSENT -->|Нет| FREE_END["Материал доступен, цепочка остановлена"]
  CONSENT -->|Да| MODE{"Режим проекта"}
  MODE -->|Рост| WAITLIST["Запись в лист ожидания"]
  MODE -->|С нуля, продукт не готов| WAITLIST
  WAITLIST --> WAIT_END["Подтверждение и остановка"]
  MODE -->|Некоммерческий| COMMUNITY["Приглашение к участию"]
  MODE -->|С нуля с готовым продуктом| BUYER_CHECK{"Продукт уже оплачен?"}
  BUYER_CHECK -->|Да| BUYER
  BUYER_CHECK -->|Нет| OTO["OTO: цена и стабильный дедлайн"]
  OTO --> CHOICE{"Действие пользователя"}
  CHOICE -->|Купить| EXP{"Предложение ещё действует?"}
  CHOICE -->|Молчит| PUSH_CHECK{"Есть согласие, не купил, лимит не исчерпан?"}
  CHOICE -->|Остановить| UNSUB["Отписка и отмена очереди"]
  PUSH_CHECK -->|Нет| END_SALES["Продажная цепочка остановлена"]
  PUSH_CHECK -->|Да| PUSH["Одно разрешённое напоминание"]
  PUSH --> END_SALES
  END_SALES -->|Новый явный запрос покупки| EXP
  EXP -->|Да| INVOICE["Создать заказ по цене OTO"]
  EXP -->|Нет| BASE["Обычная цена или закрытый оффер"]
  BASE -->|Доступен и пользователь согласен| INVOICE_BASE["Заказ по обычной цене"]
  BASE -->|Недоступен или отказ| END_SALES
  INVOICE --> RESULT{"Статус провайдера"}
  INVOICE_BASE --> RESULT
  RESULT -->|Pending| PENDING["Ожидание подтверждения"]
  PENDING -->|Новое событие провайдера| RESULT
  RESULT -->|Failed| SUPPORT["Помощь и добровольный повтор"]
  SUPPORT -->|Пользователь повторяет| EXP
  RESULT -->|Success| VERIFY{"Проверены заказ, сумма и валюта?"}
  VERIFY -->|Нет| REVIEW["Ручная проверка без выдачи"]
  VERIFY -->|Да| ACCESS["Однократная выдача и отмена пушей"]
  ACCESS --> BUYER["Клиент: доступ и поддержка"]
  BUYER -->|Подтверждённый возврат| REFUND["Возврат по условиям, отмена продажной очереди"]
